#!/usr/bin/env python3
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import urllib.error
import urllib.request
from uuid import uuid4

ROOT=Path(__file__).resolve().parent


def call(method,path,data=None,headers=None):
    token=(ROOT/'.secrets/api_token').read_text().strip()
    port=os.getenv('MEMORY_PORT','8765')
    if (ROOT/'.env').exists():
        for line in (ROOT/'.env').read_text().splitlines():
            if line.startswith('MEMORY_PORT=') and not os.getenv('MEMORY_PORT'): port=line.split('=',1)[1]
    base=os.getenv('MEMORY_URL','http://127.0.0.1:'+port)
    req=urllib.request.Request(base+path,data=json.dumps(data,ensure_ascii=False).encode() if data is not None else None,
        headers={'Authorization':'Bearer '+token,'Content-Type':'application/json',**(headers or {})},method=method)
    try:
        with urllib.request.urlopen(req,timeout=210) as response: return json.load(response)
    except urllib.error.HTTPError as exc:
        body=json.loads(exc.read())
        raise RuntimeError(json.dumps(body,ensure_ascii=False)) from exc


def main():
    parser=argparse.ArgumentParser(description='家庭 AI 本地记忆')
    subs=parser.add_subparsers(dest='command',required=True)
    p=subs.add_parser('remember');p.add_argument('text');p.add_argument('--local-only',action='store_true');p.add_argument('--subject',default='user');p.add_argument('--until');p.add_argument('--key')
    p=subs.add_parser('list');p.add_argument('--limit',type=int,default=20);p.add_argument('--offset',type=int,default=0)
    p=subs.add_parser('show');p.add_argument('id');p.add_argument('--history',action='store_true')
    p=subs.add_parser('search');p.add_argument('query')
    p=subs.add_parser('correct');p.add_argument('id');p.add_argument('text');p.add_argument('--revision',type=int)
    p=subs.add_parser('forget');p.add_argument('id')
    p=subs.add_parser('reindex');p.add_argument('id')
    p=subs.add_parser('chat');p.add_argument('text',nargs='?');p.add_argument('--conversation');p.add_argument('--no-auto-memory',action='store_true')
    p=subs.add_parser('history');p.add_argument('id')
    p=subs.add_parser('clear-history');p.add_argument('id')
    subs.add_parser('backup')
    p=subs.add_parser('restore');p.add_argument('file')
    args=parser.parse_args()
    command=args.command
    if command in ('backup','restore'):
        return subprocess.call([sys.executable,str(ROOT/'scripts/manage.py'),command]+([args.file] if command=='restore' else []))
    if command=='remember':
        data={'text':args.text,'allow_cloud':not args.local_only,'subject':args.subject}
        if args.until: data['valid_until']=args.until
        result=call('POST','/v1/memories',data,{'Idempotency-Key':args.key or str(uuid4())})
    elif command=='list': result=call('GET',f'/v1/memories?limit={args.limit}&offset={args.offset}')
    elif command=='show': result=call('GET','/v1/memories/'+args.id+('?history=true' if args.history else ''))
    elif command=='search': result=call('POST','/v1/search',{'query':args.query})
    elif command=='correct':
        revision=args.revision or call('GET','/v1/memories/'+args.id)['revision']
        result=call('PATCH','/v1/memories/'+args.id,{'expected_revision':revision,'text':args.text})
    elif command=='forget': result=call('DELETE','/v1/memories/'+args.id)
    elif command=='reindex': result=call('POST','/v1/memories/'+args.id+'/reindex')
    elif command=='history': result=call('GET','/v1/conversations/'+args.id)
    elif command=='clear-history': result=call('DELETE','/v1/conversations/'+args.id)
    elif args.text:
        data={'text':args.text,'auto_memory':not args.no_auto_memory}
        if args.conversation: data['conversation_id']=args.conversation
        result=call('POST','/v1/chat',data)
    else:
        conversation=args.conversation
        print('输入开始；自动整理值得记住的信息。/new 新会话，/exit 结束。')
        while True:
            try: text=input('你 > ').strip()
            except EOFError: break
            if text=='/exit': break
            if text=='/new': conversation=None;continue
            if not text: continue
            try:
                data={'text':text,'auto_memory':not args.no_auto_memory}
                if conversation: data['conversation_id']=conversation
                result=call('POST','/v1/chat',data)
                conversation=result['conversation_id']
                print('她 > '+result['answer'])
                for change in result.get('memory_changes',[]):
                    label={'create':'已记住','update':'已更新','forget':'已遗忘'}[change['operation']]
                    print('  ['+label+'] '+(change.get('text') or change['id']))
            except Exception as exc: print(str(exc),file=sys.stderr)
        return 0
    print(json.dumps(result,ensure_ascii=False,indent=2))
    return 0


if __name__=='__main__':
    try: sys.exit(main())
    except KeyboardInterrupt: sys.exit(130)
    except Exception as exc:
        print(str(exc) if isinstance(exc,RuntimeError) else type(exc).__name__,file=sys.stderr)
        sys.exit(1)
